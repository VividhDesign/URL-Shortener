# ─── SnapLink — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your actual values.
# Never commit your real .env file to git.

# ── Backend ─────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/urlshortener

# Redis connection string
# Local:   redis://localhost:6379
# Upstash: rediss://<user>:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Base URL for the backend (used to build short URLs)
# Local:      http://localhost:5001
# Production: https://your-backend.onrender.com
BASE_URL=http://localhost:5001

# Port (Render sets this automatically in production)
PORT=5001

# ── Frontend ─────────────────────────────────────────────────────

# Your deployed Vercel frontend URL — used in CORS allowlist (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
